# CodeNest environment variables. Copy to .env and supply your own values.
MONGODB_URI=mongodb://localhost:27017/codenest
REDIS_URL=redis://localhost:6379
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
INVITE_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional runtime settings (npm start sets NODE_ENV automatically)
NODE_ENV=development
PORT=3000
# NEXT_PRIVATE_DISABLE_TURBOPACK is set internally by server.js.

# Optional comma-separated exact origins; defaults to NEXTAUTH_URL
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
